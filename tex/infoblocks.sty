% infoblocks.sty -- infographic building blocks for Beamer slides
%
% Icon circles, cards, stat tiles and percentage meters, as in the Quarto
% JECS decks. Works with any theme (made for the JECS and NIES themes in
% ~/dev/tex/): the accent colours are the package's own, with the JECS
% palette values, so they do not depend on which theme is loaded.
%
% Accent names, used as the optional first argument everywhere:
%   navy (default), red, teal, plain
% Add your own with \ibdefineaccent{name}{accent}{tint}{ink}.
%
% Commands
%   \iconcircle[accent]{icon}          white icon on a filled circle
%   \softicon[accent]{icon}            accent-coloured icon on a pale circle
%   \stat[accent]{text}                big bold number, as its own paragraph
%   \stattile[accent][tcb opts]{icon}{number}{label}
%   \begin{infocard}[accent][tcb opts]{icon}{title} ... \end{infocard}
%   \meter[accent]{percent}[bar width] value above a bar
%   \ibchip[accent]{text}               small rounded label ("pill")
%   \begin{takeaway} ... \end{takeaway} navy bar for a slide's key message
%
% Icons are Font Awesome 7 Free names (texdoc fontawesome7), e.g. users,
% thumbs-up, laptop, magnifying-glass, vault. (The bootstrapicons package
% draws icons as black PDF images that cannot be recoloured, so it cannot
% give a white icon on a filled circle.)
%
% Needs XeLaTeX or LuaLaTeX (fontawesome7 uses fontspec).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{infoblocks}[2026/11/16 v0.1 Infographic blocks for Beamer]

\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fontawesome7}
\RequirePackage{etoolbox}

% ---- palette (JECS values) ------------------------------------------------
\definecolor{ibnavy}{RGB}{0,47,92}        % JECS / NIES navyblue
\definecolor{ibred}{RGB}{217,52,72}       % JECS karakurenai
\definecolor{ibteal}{RGB}{85,179,162}     % JECS / NIES turquoise
\definecolor{ibtext}{RGB}{54,69,79}       % JECS / NIES charcoal

% ---- accents ---------------------------------------------------------------
% Each accent has: accent (fills, rules), tint (card background), ink (text).
\newcommand\ibdefineaccent[4]{%
  \colorlet{ib#1accent}{#2}\colorlet{ib#1tint}{#3}\colorlet{ib#1ink}{#4}}
\ibdefineaccent{navy}{ibnavy}{ibnavy!6}{ibnavy}
\ibdefineaccent{red}{ibred}{ibred!9}{ibred}
\ibdefineaccent{teal}{ibteal}{ibteal!13}{ibteal!55!black}
\ibdefineaccent{plain}{black!22}{black!4}{black!55}

% Selects an accent for the current group: sets ibaccent, ibtint, ibink.
\newcommand\ibsetaccent[1]{%
  \colorlet{ibaccent}{ib#1accent}\colorlet{ibtint}{ib#1tint}\colorlet{ibink}{ib#1ink}}
\ibsetaccent{navy}

% ---- icons -----------------------------------------------------------------
% The circle is 2.1em across, so it follows the current font size.
\NewDocumentCommand\iconcircle{O{navy} m}{{%
  \ibsetaccent{#1}%
  \tikz[baseline=(ibic.base)]
    \node[circle, fill=ibaccent, text=white, minimum size=2.1em,
          inner sep=0pt] (ibic) {\faIcon{#2}};}}
\NewDocumentCommand\softicon{O{navy} m}{{%
  \ibsetaccent{#1}%
  \tikz[baseline=(ibic.base)]
    \node[circle, fill=ibtint, text=ibink, minimum size=2.1em,
          inner sep=0pt] (ibic) {\faIcon{#2}};}}

% ---- big number --------------------------------------------------------------
% A paragraph of its own. \par sits inside the \Large group, so the line keeps
% \Large leading (outside it, the next line would collide).
\NewDocumentCommand\stat{O{navy} m}{{%
  \ibsetaccent{#1}\color{ibink}\Large\bfseries #2\par}\vspace{2pt}}

% ---- card ------------------------------------------------------------------
% Pale background, accent rule on top, icon + title header. Pass
% `equal height group=NAME` in the second optional argument to level the
% bottoms of cards set side by side.
\NewTColorBox{infocard}{O{navy} O{} m m}{%
  enhanced, code={\ibsetaccent{#1}},
  colback=ibtint, frame hidden, arc=3pt,
  borderline north={1.6pt}{0pt}{ibaccent},
  left=5pt, right=5pt, top=5pt, bottom=5pt, boxsep=0pt,
  fontupper=\scriptsize, before skip=0pt, after skip=0pt,
  % Narrow list indent inside the card (Beamer's default suits full width).
  % An empty icon argument {} gives a card without the icon circle.
  before upper={\setlength{\leftmargini}{1.1em}\setlength{\labelsep}{0.4em}%
    \ifblank{#3}{}{{\normalsize\iconcircle[#1]{#3}}\par\vspace{3pt}}%
    {\small\bfseries\color{ibink}#4\par}\vspace{2pt}},
  #2}

% ---- stat tile -------------------------------------------------------------
% Icon left; number and label right.
\NewDocumentCommand\stattile{O{navy} O{} m m m}{%
  \begin{tcolorbox}[enhanced, code={\ibsetaccent{#1}},
      colback=ibtint, frame hidden, arc=3pt,
      left=5pt, right=5pt, top=4pt, bottom=4pt, boxsep=0pt,
      before skip=0pt, after skip=0pt, #2]
    \begin{tikzpicture}[baseline=(n.base)]
      \node[circle, fill=ibaccent, text=white, minimum size=2.1em,
            inner sep=0pt, font=\large] (i) {\faIcon{#3}};
      % The number stays on one line; the label wraps within the tile.
      \node[anchor=south west, inner sep=0pt, font=\Large\bfseries,
            text=ibink] (n) at ([xshift=6pt]i.east) {#4};
      \node[anchor=north west, inner sep=0pt, font=\scriptsize,
            text=ibtext!85, text width=\linewidth-2.1em-8pt, align=left]
            at ([yshift=-2pt]n.south west) {#5};
    \end{tikzpicture}%
  \end{tcolorbox}}

% ---- percentage meter --------------------------------------------------------
\NewDocumentCommand\meter{O{navy} m O{\linewidth}}{{%
  \ibsetaccent{#1}%
  \begin{tikzpicture}[baseline=(v.base)]
    \node[anchor=south west, inner sep=0pt, font=\small\bfseries,
          text=ibink] (v) at (0,3pt) {#2\%};
    \fill[black!12, rounded corners=1.2pt] (0,0) rectangle (#3,-2.6pt);
    \fill[ibaccent, rounded corners=1.2pt] (0,0) rectangle ({#2/100*#3},-2.6pt);
  \end{tikzpicture}}}

% ---- chip ------------------------------------------------------------------
\NewDocumentCommand\ibchip{O{teal} m}{{%
  \ibsetaccent{#1}%
  \tcbox[on line, colback=ibtint, colframe=ibtint, coltext=ibink,
         boxrule=0pt, arc=5pt, boxsep=0pt, left=4pt, right=4pt,
         top=1.5pt, bottom=1.5pt, fontupper=\tiny\bfseries]{#2}}}

% ---- takeaway bar ------------------------------------------------------------
\newtcolorbox{takeaway}[1][]{%
  enhanced, colback=ibnavy, colframe=ibnavy, coltext=white,
  boxrule=0pt, arc=3pt, left=6pt, right=6pt, top=4pt, bottom=4pt,
  boxsep=0pt, fontupper=\scriptsize\bfseries, before skip=4pt, after skip=0pt,
  #1}

\endinput
